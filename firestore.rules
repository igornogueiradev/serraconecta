rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Motoristas: leitura pública, escrita apenas autenticado, edição/exclusão apenas pelo dono
    match /drivers/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Viagens: leitura pública, escrita apenas autenticado, edição/exclusão apenas pelo dono
    match /trips/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }

    // Perfis: leitura pública (necessário para mostrar nome/telefone nos cards),
    // escrita apenas pelo próprio usuário
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
